# Server Configuration
PORT=3000

# Neon CRM API Credentials
NEON_ORG_ID=
NEON_API_KEY=
NEON_API_URL=https://api.neoncrm.com/v2

# SMTP Configuration for Email Reports
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Neon CRM Dashboard <noreply@yourdomain.com>"
EMAIL_RECIPIENT=

# Automated Email Schedule (cron format)
# Default: Every day at 8:00 AM (0 8 * * *)
EMAIL_SCHEDULE="0 8 * * *"
EMAIL_ENABLED=false

# Gemini AI Configuration
GEMINI_API_KEY=

